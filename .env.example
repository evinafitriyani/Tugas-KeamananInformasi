# CampusVault environment template.
# Copy this file to .env, then fill the two secrets with fresh random values.
# Never commit .env or reuse a key that has ever appeared in Git history.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Base64 of at least 32 random bytes. Suggested generation:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
CAMPUSVAULT_MASTER_KEY=

# At least 32 characters. Generate a separate random value:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

DATABASE_PATH=./server/data/database.sqlite
STORAGE_DIR=./server/data/storage
SESSION_TTL_MS=7200000
MAX_UPLOAD_BYTES=26214400
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
